# Copy to .env.local and fill in. Never commit real values.

# Supabase (Phase 2). The anon key is safe for the browser; the service-role key is NOT
# and must only ever live in Supabase Edge Function secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL, used for canonical links and Open Graph tags.
VITE_SITE_URL=

# Maps (optional). Leave empty to show the address with a "Get directions" link instead.
VITE_GOOGLE_MAPS_EMBED_KEY=
